	$(MAKE) $(MAKESILENT) -f CMakeFiles\ReservationQueueTest.dir\build.make CMakeFiles/ReservationQueueTest.dir/tests/ReservationQueueTest.cpp.i
.PHONY : tests/ReservationQueueTest.cpp.i

tests/ReservationQueueTest.s: tests/ReservationQueueTest.cpp.s
.PHONY : tests/ReservationQueueTest.s

# target to generate assembly for a file
tests/ReservationQueueTest.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\ReservationQueueTest.dir\build.make CMakeFiles/ReservationQueueTest.dir/tests/ReservationQueueTest.cpp.s
.PHONY : tests/ReservationQueueTest.cpp.s

